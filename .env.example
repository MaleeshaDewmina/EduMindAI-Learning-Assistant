# Copy to .env and fill with your local/deployment values.
# Never commit your populated .env file. Generate SECRET_KEY securely.
SECRET_KEY=

DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edumind_ai_db
DB_SSL_CA_PATH=

GROQ_API_KEY=
